{
  "type": "DelimitedText",
  "linkedServiceName": { "referenceName": "ls_adls", "type": "LinkedServiceReference" },
  "parameters": {
    "folder": { "type": "String" },
    "file": { "type": "String" }
  },
  "typeProperties": {
